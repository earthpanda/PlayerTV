<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/template_background" android:padding="20pt">
    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content"
            android:text="@string/s_ble_demo_title" android:textAppearance="@style/TextAppearance.Template.Title"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />
        <TextView android:id="@+id/description" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginTop="12pt" android:text="@string/s_ble_demo_description"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/title" />
        <TextView android:id="@+id/scan" style="@style/Widget.Template.TextAction"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="12pt"
            android:text="@string/s_ble_demo_scan" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/description" />
        <TextView android:id="@+id/stop" style="@style/Widget.Template.TextAction"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="8pt"
            android:text="@string/s_ble_demo_stop" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/scan" />
        <TextView android:id="@+id/radio_settings" style="@style/Widget.Template.TextAction"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="8pt"
            android:text="@string/s_ble_demo_radio_settings" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/stop" />
        <TextView android:id="@+id/scan_status" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginTop="12pt" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/radio_settings" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/devices"
            android:layout_width="0dp" android:layout_height="220pt" android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/scan_status" />
        <TextView android:id="@+id/connection_status" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginTop="12pt" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/devices" />
        <TextView android:id="@+id/error" android:layout_width="0dp" android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/connection_status" />
        <TextView android:id="@+id/services" android:layout_width="0dp" android:layout_height="wrap_content"
            android:textIsSelectable="true" android:layout_marginTop="8pt"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/error" />
        <TextView android:id="@+id/fixture_label" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginTop="24pt" android:text="@string/s_ble_demo_fixture_label"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/services" />
        <TextView android:id="@+id/round_trip" style="@style/Widget.Template.TextAction"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="8pt"
            android:text="@string/s_ble_demo_round_trip" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/fixture_label" />
        <TextView android:id="@+id/reconnect" style="@style/Widget.Template.TextAction"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="8pt"
            android:text="@string/s_ble_demo_reconnect" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/round_trip" />
        <TextView android:id="@+id/timeout" style="@style/Widget.Template.TextAction"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="8pt"
            android:text="@string/s_ble_demo_timeout" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/reconnect" />
        <TextView android:id="@+id/stale" style="@style/Widget.Template.TextAction"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="8pt"
            android:text="@string/s_ble_demo_stale" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/timeout" />
        <TextView android:id="@+id/fixture_status" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginTop="12pt" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/stale" app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
