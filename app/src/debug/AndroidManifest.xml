<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <application android:name=".SourcePreviewApplication" tools:replace="android:name">
        <activity android:name=".ui.test.sample.SampleActivity" tools:node="remove" />
        <activity android:name=".ui.test.tvplayback.TvPlaybackActivity" android:exported="false" android:screenOrientation="landscape" />
        <activity android:name=".ui.test.sourcesearch.SourceSearchActivity" android:exported="false" android:screenOrientation="landscape" />
        <activity android:name=".ui.test.sourceentry.ShareSourceImportActivity" android:exported="true"
            android:excludeFromRecents="true" android:theme="@android:style/Theme.NoDisplay" />
        <activity android:name=".ui.test.sourceentry.SourceEntryActivity" android:exported="true" android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <meta-data android:name="com.gentv.tv.home.PROTOCOL_MAJOR" android:value="1" />
            <meta-data android:name="com.gentv.tv.home.CONTENT_SERVICE"
                android:value="com.ai.playtv.service.homecontent.HomeContentService" />
        </activity>
    </application>
</manifest>
