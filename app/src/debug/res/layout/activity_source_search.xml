<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#15171C">

    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/search_panel"
        android:layout_width="0dp" android:layout_height="0dp" android:background="#26090D11"
        app:layout_constraintWidth_percent="0.344" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent">
        <ImageView android:id="@+id/search_icon" android:layout_width="33pt" android:layout_height="33pt"
            android:layout_marginStart="40pt" android:importantForAccessibility="no"
            android:src="@drawable/icon_nav_search_foc" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/search_input" app:layout_constraintBottom_toBottomOf="@id/search_input" />
        <TextView android:id="@+id/search_input" android:layout_width="0dp" android:layout_height="66pt"
            android:layout_marginStart="10pt" android:layout_marginEnd="40pt" android:layout_marginTop="26pt"
            android:gravity="center_vertical" android:singleLine="true" android:ellipsize="end"
            android:hint="@string/s_search_hint" android:textColor="#EEEEEE" android:textColorHint="#80EEEEEE"
            android:textSize="21pt" app:layout_constraintStart_toEndOf="@id/search_icon"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />
        <View android:id="@+id/search_divider" android:layout_width="0dp" android:layout_height="1pt"
            android:background="#33FFFFFF" app:layout_constraintStart_toStartOf="@id/search_icon"
            app:layout_constraintEnd_toEndOf="@id/search_input" app:layout_constraintTop_toBottomOf="@id/search_input" />
        <GridLayout android:id="@+id/keyboard" android:layout_width="0dp" android:layout_height="0dp"
            android:layout_marginTop="53pt" android:columnCount="6" android:rowCount="6"
            app:layout_constraintStart_toStartOf="@id/search_icon" app:layout_constraintEnd_toEndOf="@id/search_input"
            app:layout_constraintTop_toBottomOf="@id/search_divider" app:layout_constraintDimensionRatio="H,1:1" />
        <FrameLayout android:id="@+id/clear" android:layout_width="48pt" android:layout_height="48pt"
            android:layout_marginTop="22pt" android:gravity="center" android:focusable="true" android:clickable="true"
            android:background="@drawable/source_search_focus" android:contentDescription="@string/s_search_clear"
            app:layout_constraintStart_toStartOf="@id/keyboard" app:layout_constraintTop_toBottomOf="@id/keyboard">
            <ImageView android:layout_width="33pt" android:layout_height="33pt" android:layout_gravity="center"
                android:importantForAccessibility="no" android:src="@drawable/icon_btn_clean_foc" />
        </FrameLayout>
        <FrameLayout android:id="@+id/delete" android:layout_width="48pt" android:layout_height="48pt"
            android:gravity="center" android:focusable="true" android:clickable="true"
            android:background="@drawable/source_search_focus" android:contentDescription="@string/s_search_delete"
            app:layout_constraintEnd_toEndOf="@id/keyboard" app:layout_constraintTop_toTopOf="@id/clear">
            <ImageView android:layout_width="33pt" android:layout_height="33pt" android:layout_gravity="center"
                android:importantForAccessibility="no" android:src="@drawable/icon_btn_delete_foc" />
        </FrameLayout>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="40pt"
            android:text="@string/s_search_tips" android:textColor="#80FFFFFF" android:textSize="18pt"
            app:layout_constraintStart_toStartOf="@id/keyboard" app:layout_constraintEnd_toEndOf="@id/keyboard"
            app:layout_constraintTop_toBottomOf="@id/clear" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout android:layout_width="0dp" android:layout_height="0dp" android:orientation="vertical"
        android:paddingStart="23pt" android:paddingEnd="40pt" android:paddingTop="46pt"
        app:layout_constraintStart_toEndOf="@id/search_panel" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent">
        <TextView android:id="@+id/result_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#80EEEEEE" android:textSize="21pt" />
        <TextView android:id="@+id/partial" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4pt" android:text="@string/s_search_partial" android:textColor="#B7B7B7" android:textSize="12pt" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/results" android:layout_width="match_parent"
                android:layout_height="match_parent" android:clipChildren="false" android:clipToPadding="false"
                android:paddingTop="35pt" />
            <TextView android:id="@+id/message" android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center" android:textColor="#CCFFFFFF" android:textSize="18pt" />
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
