<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#15171C" android:descendantFocusability="afterDescendants">

    <LinearLayout android:id="@+id/sidebar" android:layout_width="0dp" android:layout_height="0dp"
        android:orientation="vertical" android:gravity="center_vertical" android:background="#26000000"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0" app:layout_constraintWidth_percent="0.18"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent">
        <TextView android:id="@+id/history_tab" android:layout_width="match_parent" android:layout_height="56pt"
            android:background="@drawable/source_home_tab_background" android:clickable="true"
            android:focusable="true" android:focusableInTouchMode="true" android:gravity="center" android:singleLine="true"
            android:text="@string/s_tv_home_history" android:textColor="@color/source_home_tab_text"
            android:textSize="14pt" android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="9pt" android:autoSizeMaxTextSize="14pt" />
        <TextView android:id="@+id/source_tab" android:layout_width="match_parent" android:layout_height="56pt"
            android:background="@drawable/source_home_tab_background" android:clickable="true"
            android:focusable="true" android:focusableInTouchMode="true" android:gravity="center" android:singleLine="true"
            android:text="@string/s_tv_home_sources" android:textColor="@color/source_home_tab_text"
            android:textSize="14pt" android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="9pt" android:autoSizeMaxTextSize="14pt" />
    </LinearLayout>

    <FrameLayout android:id="@+id/search_tab" android:layout_width="0dp" android:layout_height="56pt"
        android:layout_marginTop="22pt" android:background="@drawable/source_home_tab_background"
        android:clickable="true" android:focusable="true" android:focusableInTouchMode="true"
        android:contentDescription="@string/s_search_entry" app:layout_constraintStart_toStartOf="@id/sidebar"
        app:layout_constraintEnd_toEndOf="@id/sidebar" app:layout_constraintTop_toTopOf="parent">
        <ImageView android:layout_width="28pt" android:layout_height="28pt" android:layout_marginStart="14pt"
            android:layout_gravity="start|center_vertical" android:duplicateParentState="true"
            android:importantForAccessibility="no" android:src="@drawable/source_search_icon" />
        <TextView android:layout_width="match_parent" android:layout_height="match_parent"
            android:layout_marginStart="53pt" android:layout_marginEnd="8pt" android:gravity="center_vertical"
            android:singleLine="true" android:duplicateParentState="true" android:importantForAccessibility="no"
            android:text="@string/s_search_entry" android:textColor="@color/source_home_tab_text"
            android:textSize="18pt" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10pt"
            android:autoSizeMaxTextSize="18pt" />
    </FrameLayout>

    <FrameLayout android:id="@+id/content" android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintStart_toEndOf="@id/sidebar" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout android:id="@+id/history_panel" android:layout_width="match_parent"
            android:layout_height="match_parent" android:orientation="vertical" android:padding="32pt">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/s_tv_history_title" android:textColor="#FFFFFF" android:textSize="18pt" />
            <TextView android:id="@+id/history_message" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4pt" android:textColor="#CCCCCC" android:textSize="12pt" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/history" android:layout_width="match_parent"
                    android:layout_height="match_parent" android:clipToPadding="false"
                    android:descendantFocusability="afterDescendants" android:focusable="true" />
                <LinearLayout android:id="@+id/history_empty" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_gravity="center"
                    android:orientation="vertical" android:gravity="center" android:visibility="gone">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/s_tv_history_empty" android:textColor="#CCCCCC" android:textSize="16pt" />
                    <TextView android:id="@+id/add_source" style="@style/Widget.TvPlaybackPreview.Control"
                        android:layout_marginTop="20pt" android:minWidth="140pt"
                        android:background="@drawable/source_home_action_background" android:textColor="#FFFFFF"
                        android:text="@string/s_tv_home_add_source" />
                </LinearLayout>
                <com.ai.playtv.view.loading.CustomLoadingView android:id="@+id/history_loading"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center" />
            </FrameLayout>
        </LinearLayout>

        <ScrollView android:id="@+id/source_panel" android:layout_width="match_parent"
            android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center_vertical" android:padding="32pt">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/s_tv_entry_title" android:textColor="#FFFFFF" android:textSize="18pt" />
                <AutoCompleteTextView android:id="@+id/source_url" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="16pt" android:singleLine="true"
                    android:inputType="textUri" android:minHeight="48pt" android:paddingStart="8pt"
                    android:paddingEnd="8pt" android:focusable="true" android:focusableInTouchMode="true"
                    android:completionThreshold="1" android:background="@drawable/source_entry_focus_background"
                    android:hint="@string/s_tv_import_hint" android:textColor="#FFFFFF"
                    android:textColorHint="#A0FFFFFF" android:textSize="14pt" />
                <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8pt" android:textColor="#FFB0B0" android:textSize="12pt" />
                <TextView android:id="@+id/submit" style="@style/Widget.TvPlaybackPreview.Control"
                    android:layout_gravity="end" android:layout_marginTop="16pt" android:text="@string/s_tv_entry_start" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
