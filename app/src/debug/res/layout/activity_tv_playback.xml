<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000">
    <SurfaceView android:id="@+id/video" android:layout_width="match_parent" android:layout_height="match_parent" />
    <TextView android:id="@+id/audio_without_video" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|end" android:layout_marginTop="72pt" android:layout_marginEnd="24pt"
        android:background="#99000000" android:padding="6pt" android:text="@string/s_tv_preview_audio_without_video"
        android:textColor="#FFFFFF" android:textSize="12pt" android:visibility="gone" />
    <TextView android:id="@+id/buffering" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|end" android:layout_marginTop="40pt" android:layout_marginEnd="24pt"
        android:background="#99000000" android:padding="6pt" android:textColor="#FFFFFF" android:textSize="12pt"
        android:visibility="gone" />
    <LinearLayout android:id="@+id/top_controls" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_gravity="top"
        android:background="@drawable/tv_preview_top_gradient" android:gravity="center_vertical"
        android:orientation="horizontal" android:paddingStart="24pt" android:paddingTop="10pt"
        android:paddingEnd="24pt" android:paddingBottom="20pt">
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:ellipsize="end" android:singleLine="true"
            android:text="@string/s_tv_preview_title" android:textColor="#FFFFFF" android:textSize="14pt" />
        <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="16pt" android:textColor="#FFFFFF" android:textSize="14pt" />
    </LinearLayout>
    <LinearLayout android:id="@+id/bottom_controls" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_gravity="bottom"
        android:background="@drawable/tv_preview_bottom_gradient" android:orientation="vertical"
        android:paddingStart="24pt" android:paddingTop="28pt" android:paddingEnd="24pt" android:paddingBottom="10pt">
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="2" android:textColor="#FFFFFF" android:textSize="12pt" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/elapsed" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/s_tv_preview_zero_time" android:textColor="#FFFFFF" android:textSize="12pt" />
            <com.ai.playtv.ui.test.tvplayback.CustomPlaybackProgressView android:id="@+id/progress"
                android:layout_width="0dp" android:layout_height="40pt" android:layout_marginStart="8pt"
                android:layout_marginEnd="8pt" android:layout_weight="1" />
            <TextView android:id="@+id/duration" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/s_tv_preview_unknown_time" android:textColor="#FFFFFF" android:textSize="12pt" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="end|center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/hint" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:ellipsize="end" android:maxLines="2"
                android:text="@string/s_tv_preview_controls_hint" android:textColor="#B3FFFFFF" android:textSize="11pt" />
            <TextView android:id="@+id/toggle" style="@style/Widget.TvPlaybackPreview.Control"
                android:layout_marginStart="8pt" android:text="@string/s_tv_preview_play" />
        </LinearLayout>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/playlist_overlay"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:clickable="true" android:visibility="gone">
        <LinearLayout android:id="@+id/playlist_panel" android:layout_width="0dp"
            android:layout_height="0dp" android:background="#E6191B20" android:clickable="true"
            android:orientation="vertical" android:padding="20pt"
            app:layout_constraintWidth_percent="0.5" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/s_tv_preview_playlist" android:textColor="#FFFFFF" android:textSize="18pt" />
            <TextView android:id="@+id/import_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#CCCCCC" android:textSize="11pt" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/playlist" android:layout_width="match_parent"
                android:layout_height="0dp" android:layout_marginTop="12pt" android:layout_weight="1" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
