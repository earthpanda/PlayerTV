<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginStart="18pt" android:layout_marginEnd="18pt" android:layout_marginBottom="36pt"
    android:focusable="true" android:clickable="true">
    <FrameLayout android:id="@+id/poster_placeholder" android:layout_width="0dp" android:layout_height="0dp"
        android:background="#303740" app:layout_constraintDimensionRatio="H,2:3"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView android:id="@+id/poster" android:layout_width="match_parent"
            android:layout_height="match_parent" android:scaleType="fitCenter"
            android:importantForAccessibility="no" />
    </FrameLayout>
    <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="42pt"
        android:background="@drawable/source_search_card_title" android:duplicateParentState="true"
        android:gravity="center" android:singleLine="true" android:ellipsize="end"
        android:marqueeRepeatLimit="marquee_forever"
        android:paddingStart="8pt" android:paddingEnd="8pt" android:textColor="@color/source_search_card_title"
        android:textSize="17pt" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/poster_placeholder" app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
