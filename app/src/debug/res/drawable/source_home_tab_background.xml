<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><gradient android:angle="0" android:startColor="#20C4EE" android:endColor="#3283F5" /></shape>
    </item>
    <item android:state_selected="true">
        <layer-list>
            <item><shape><solid android:color="#263A4E" /></shape></item>
            <item android:width="4pt" android:gravity="start|fill_vertical">
                <shape><solid android:color="#22BDF2" /></shape>
            </item>
        </layer-list>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
