<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape><solid android:color="#4DFFFFFF" /><corners android:radius="4pt" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#FFD66B" /><corners android:radius="4pt" /></shape>
    </item>
    <item android:state_focused="true">
        <shape><solid android:color="#FFFFFF" /><corners android:radius="4pt" /></shape>
    </item>
    <item>
        <shape><solid android:color="#2650B4" /><corners android:radius="4pt" /></shape>
    </item>
</selector>
